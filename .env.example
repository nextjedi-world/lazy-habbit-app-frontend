# Names only. The app reads its config from src/environments/environment.ts (git-ignored; created by
# `make setup` from environment.example.ts). CI and Vercel write that file from these secrets.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Optional: Sentry error tracking is a no-op when empty.
SENTRY_DSN=
# Vercel deploy (GitHub Actions secrets)
VERCEL_TOKEN=
VERCEL_ORG_ID=
VERCEL_PROJECT_ID=
